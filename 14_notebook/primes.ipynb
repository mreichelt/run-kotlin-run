   "source": [
    "fun isPrime(n: Long): Boolean {\n",
    "    if (n <= 1L) return false\n",
    "    if (n == 2L) return true\n",
    "    if (n % 2 == 0L) return false\n",
    "    var i = 3L\n",
    "    while (i * i <= n) {\n",
    "        if (n % i == 0L) return false\n",
    "        i += 2L\n",
    "    }\n",
    "    return true\n",
    "}\n",
    "\n",
    "(1L..100L).filter { isPrime(it) }"
   ],
